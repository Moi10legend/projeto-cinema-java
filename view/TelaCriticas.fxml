<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<VBox alignment="TOP_CENTER" spacing="15.0" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.TelaCriticasController">
    <padding><Insets top="20" right="25" bottom="20" left="25"/></padding>

    <Label fx:id="tituloFilmeLabel" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
    <Label fx:id="mediaGeralLabel" style="-fx-font-size: 16px; -fx-text-fill: #e65100; -fx-font-weight: bold;"/>

    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
        <content>
            <VBox fx:id="listaCriticasContainer" spacing="12.0">
                <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
            </VBox>
        </content>
    </ScrollPane>

    <Button text="Voltar para Sessões" onAction="#voltarParaSessoes" style="-fx-padding: 8 20; -fx-cursor: hand;"/>
</VBox>